<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_cream">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_group"
                android:textAppearance="@style/TextAppearance.Kid.Title"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="40dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/group1Button"
                    style="@style/Widget.App.Button.Kid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="@string/group_Baiterek"
                    app:backgroundTint="@color/primary_pastel_green"
                    android:layout_margin="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/group2Button"
                    style="@style/Widget.App.Button.Kid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="@string/group_Kulynshak"
                    app:backgroundTint="@color/secondary_pastel_yellow"
                    android:layout_margin="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/group3Button"
                    style="@style/Widget.App.Button.Kid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="@string/group_Kyran"
                    app:backgroundTint="@color/light_blue"
                    android:layout_margin="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/group4Button"
                    style="@style/Widget.App.Button.Kid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="@string/group_Zhalyn"
                    app:backgroundTint="@color/accent_peach"
                    android:layout_margin="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/group5Button"
                    style="@style/Widget.App.Button.Kid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="@string/group_Zhuldyz"
                    app:backgroundTint="@color/primary_pastel_green"
                    android:layout_margin="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/group6Button"
                    style="@style/Widget.App.Button.Kid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="@string/group_Baldauren"
                    app:backgroundTint="@color/secondary_pastel_yellow"
                    android:layout_margin="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/group7Button"
                    style="@style/Widget.App.Button.Kid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="@string/group_Baldyrgan"
                    app:backgroundTint="@color/light_blue"
                    android:layout_margin="8dp"/>


            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pure_white"
        app:itemIconTint="@color/primary_pastel_green"
        app:itemTextColor="@color/dark_brown"
        app:menu="@menu/menu_teacher"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>