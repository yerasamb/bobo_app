<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="TextAppearance.Kid.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/fredoka</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/dark_brown</item>
    </style>

    <style name="TextAppearance.Kid.Label" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/fredoka</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/dark_brown</item>
    </style>

    <style name="Widget.App.Button.Kid" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/dark_brown</item>
        <item name="backgroundTint">@color/primary_pastel_green</item>
        <item name="cornerRadius">32dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/fredoka</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">2dp</item> <!-- Lower elevation for softer feel -->
        <item name="android:stateListAnimator" tools:ignore="NewApi">@null</item>
    </style>

    <style name="Widget.App.Card.Kid" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/pure_white</item>
        <item name="cardCornerRadius">28dp</item> <!-- Slightly rounder -->
        <item name="cardElevation">2dp</item> <!-- Lower elevation -->
        <item name="strokeWidth">0dp</item>
    </style>
</resources>