<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_cream">

    <!-- Language Switcher -->
    <LinearLayout
        android:id="@+id/langContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/langKK"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KZ"
            android:padding="10dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/dark_brown"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:background="#E0E0E0" />

        <TextView
            android:id="@+id/langRU"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RU"
            android:padding="10dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/dark_brown"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:background="#E0E0E0" />

        <TextView
            android:id="@+id/langEN"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EN"
            android:padding="10dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/dark_brown"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/langContainer"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center_horizontal">

            <!-- Logo -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgLogo"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/bobo_logo"
                android:layout_marginTop="16dp"
                android:padding="2dp"
                app:strokeWidth="3dp"
                app:strokeColor="@color/primary_pastel_green"
                app:cornerSize="40dp"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/txtLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textAppearance="@style/TextAppearance.Kid.Title"
                android:textSize="32sp"
                android:layout_marginTop="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/username_label"
                    android:textAppearance="@style/TextAppearance.Kid.Label"
                    android:textColor="@color/dark_brown"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/editUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/username_hint"
                    android:background="@drawable/bg_edit_text"
                    android:inputType="text"
                    android:textAppearance="@style/TextAppearance.Kid.Label"
                    android:textColor="@color/dark_brown"
                    android:textColorHint="#757575"
                    android:padding="16dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/password_label"
                    android:textAppearance="@style/TextAppearance.Kid.Label"
                    android:textColor="@color/dark_brown"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/editPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/password_hint"
                    android:background="@drawable/bg_edit_text"
                    android:inputType="textPassword"
                    android:textAppearance="@style/TextAppearance.Kid.Label"
                    android:textColor="@color/dark_brown"
                    android:textColorHint="#757575"
                    android:padding="16dp" />

            </LinearLayout>

            <Button
                android:id="@+id/buttonLogin"
                style="@style/Widget.App.Button.Kid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_button"
                android:layout_marginTop="32dp" />

            <TextView
                android:id="@+id/btnResetPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password"
                android:textColor="@color/dark_brown"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_account"
                android:textAppearance="@style/TextAppearance.Kid.Label"
                android:textSize="14sp"
                android:layout_marginTop="32dp" />

            <Button
                android:id="@+id/btnCreateAccount"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_account"
                android:textColor="@color/primary_pastel_green"
                android:textStyle="bold"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>